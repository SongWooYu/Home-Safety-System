[Unit]
Description=Smart Home Raspberry Pi 5 Vision Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Home-Safety-System
Environment=PYTHONPATH=/home/pi/Home-Safety-System/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/Home-Safety-System/.venv/bin/python -m smarthome_vision.app
Restart=on-failure
RestartSec=5
SupplementaryGroups=video render

[Install]
WantedBy=multi-user.target
