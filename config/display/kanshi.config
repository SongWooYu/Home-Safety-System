# HDMI-A-1: Raspberry Pi OS desktop (left)
# HDMI-A-2: Home Safety demonstration (right)
profile home-safety-dual {
  output HDMI-A-1 enable mode 1920x1080@60Hz position 0,0 scale 1
  output HDMI-A-2 enable mode 1920x1080@60Hz position 1920,0 scale 1
}

profile home-safety-hdmi1-only {
  output HDMI-A-1 enable mode 1920x1080@60Hz position 0,0 scale 1
}

profile home-safety-hdmi2-only {
  output HDMI-A-2 enable mode 1920x1080@60Hz position 0,0 scale 1
}
