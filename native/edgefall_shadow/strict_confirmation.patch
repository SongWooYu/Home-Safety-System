+  // Pose is constructed in a fixed 640x640 inference space, while both the
+  // detector thresholds and temporal model were trained on normalized hip Y.
+  // Passing pixels here made a normal 0.5 input become roughly 320 and put
+  // every temporal prediction far outside its training distribution.
+  constexpr float kInferenceHeight = 640.0f;
